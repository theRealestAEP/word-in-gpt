{
  "name": "word-in-gpt",
  "private": true,
  "version": "0.1.0",
  "description": "WordInWeb as a ChatGPT app and Codex plugin: view and edit .docx files with Word fidelity",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build:app && npm run build:server",
    "build:app": "vite build",
    "build:server": "esbuild src/server/stdio.ts --bundle --platform=node --format=esm --target=node22 --outfile=plugin/dist/server.mjs",
    "build:worker-assets": "npm run build:app && node dev/prepare-worker-assets.mjs",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "serve": "node src/server/http.ts",
    "demo": "node dev/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root .",
    "test:package": "npm run build && node dev/check-local-plugin.mjs"
  },
  "dependencies": {
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/mcp-extensions": "^0.1.0",
    "@wordinweb/agent": "^0.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wordinweb": "^0.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
